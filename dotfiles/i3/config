# =============================================================================
# i3 Minimalist / Rice Configuration
# =============================================================================

# Set modifier key to Super (Windows Key)
set $mod Mod4

# Set default font
font pango:monospace 9

# Use Mouse+$mod to drag floating windows
floating_modifier $mod

# -----------------------------------------------------------------------------
# Window Aesthetics & Borders
# -----------------------------------------------------------------------------
# Hide title bars and use thin/no borders for a clean look
default_border pixel 0
default_floating_border pixel 0
for_window [class=".*"] border pixel 0

# Enable inner and outer gaps (requires i3-gaps / i3 v4.22+)
gaps inner 4
gaps outer 0

# Color scheme (Minimal Dark)
# class                 border  backgr. text    indicator child_border
client.focused          #333333 #222222 #ffffff #444444   #333333
client.focused_inactive #111111 #111111 #888888 #111111   #111111
client.unfocused        #111111 #111111 #666666 #111111   #111111
client.urgent           #900000 #900000 #ffffff #900000   #900000

# -----------------------------------------------------------------------------
# Keybindings: Core Applications & Launchers
# -----------------------------------------------------------------------------
# Terminal
bindsym $mod+Return exec alacritty

# Web Browser
bindsym $mod+b exec firefox

# App Launcher (dmenu with custom dark colors)
bindsym $mod+d exec --no-startup-id dmenu_run -fn "monospace-9" -nb "#111111" -nf "#888888" -sb "#222222" -sf "#ffffff" -p "run:"

# Screenshot tool (scrot)
bindsym Print exec --no-startup-id scrot ~/Pictures/Screenshot_%Y%m%d_%H%M%S.png

# Kill focused window
bindsym $mod+q kill

# =============================================================================
# Volume, Brightness, & Microphone Media Keys
# =============================================================================

# Audio Volume Control (PulseAudio / PipeWire)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

# Microphone Mute Toggle
bindsym XF86AudioMicMute    exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Screen Brightness Control
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# -----------------------------------------------------------------------------
# Window Navigation (Vim Keys + Arrow Keys)
# -----------------------------------------------------------------------------
# Change focus (Vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Change focus (Arrow keys)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window (Vim keys)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Move focused window (Arrow keys)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Prevent i3 from adding borders to popups and transient windows
for_window [window_role="pop-up"] border pixel 0
for_window [window_type="popup_menu"] border pixel 0
for_window [window_type="dropdown_menu"] border pixel 0
for_window [window_type="menu"] border pixel 0

# -----------------------------------------------------------------------------
# Layout & Container Management
# -----------------------------------------------------------------------------
# Toggle floating mode
bindsym $mod+Shift+space floating_toggle

# Toggle fullscreen
bindsym $mod+f fullscreen toggle

# Change container layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Focus parent container
bindsym $mod+a focus parent

# Focus child container (Remapped to $mod+c to prevent conflict with dmenu $mod+d)
bindsym $mod+c focus child

# -----------------------------------------------------------------------------
# Workspaces
# -----------------------------------------------------------------------------
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4

# -----------------------------------------------------------------------------
# i3 Management
# -----------------------------------------------------------------------------
# Reload configuration file
bindsym $mod+Shift+c reload

# Restart i3 in place
bindsym $mod+Shift+r restart

# Exit i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# -----------------------------------------------------------------------------
# Autostart Programs
# -----------------------------------------------------------------------------
# PipeWire audio daemon
exec --no-startup-id pipewire

# Set wallpaper (requires feh)
exec_always --no-startup-id feh --bg-fill ~/Pictures/notthisone.png

# Compositor for shadows/transparency (picom)
exec --no-startup-id picom -b

# Polybar launch script
exec_always --no-startup-id ~/.config/polybar/launch.sh

exec --no-startup-id dunst
exec --no-startup-id /usr/libexec/polkit-gnome-authentication-agent-1

exec_always --no-startup-id xinput disable "DELL0816:00 044E:120A Touchpad"
