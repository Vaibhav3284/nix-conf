# =============================================================================
# Dunst Notification Daemon Configuration
# =============================================================================

[global]
    ### Display & Geometry ###
    monitor = 0
    follow = mouse
    width = (0, 320)
    height = (0, 150)
    offset = (16, 44)
    origin = top-right
    notification_limit = 5
    indicate_hidden = yes

    ### Appearance ###
    font = Monospace 9
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes

    ### Borders & Padding ###
    corner_radius = 0
    border_size = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    gap_size = 6

    ### Colors & Transparency ###
    separator_color = frame
    separator_height = 2
    frame_color = "#000000"
    transparency = 0

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_frame_width = 0

[urgency_low]
    background = "#000000"
    foreground = "#888888"
    timeout = 3

[urgency_normal]
    background = "#000000"
    foreground = "#ffffff"
    timeout = 5

[urgency_critical]
    background = "#900000"
    foreground = "#ffffff"
    frame_color = "#900000"
    timeout = 0
